<%- include('partials/header') %>
<%- include('partials/navbar') %>
<%- include('partials/alerts') %>

<main class="flex-1">
  <!-- Hero Section -->
  <section class="relative overflow-hidden bg-gradient-to-b from-brand-50/70 via-white to-slate-50 pt-16 pb-20 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center max-w-3xl mx-auto">
        <span class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-brand-100 text-brand-700 text-xs font-semibold uppercase tracking-wider mb-6">
          <span class="w-2 h-2 rounded-full bg-brand-600 animate-ping"></span>
          <span>Next-Gen Campus Hub</span>
        </span>
        <h1 class="text-4xl sm:text-6xl font-extrabold text-slate-900 tracking-tight leading-tight sm:leading-none">
          College Events & <br/>
          <span class="bg-gradient-to-r from-brand-600 via-indigo-600 to-purple-600 bg-clip-text text-transparent">Room Booking System</span>
        </h1>
        <p class="mt-6 text-lg text-slate-600 leading-relaxed max-w-2xl mx-auto">
          Instant venue reservations, conflict-free scheduling, event ticketing with QR codes, real-time live updates, and automated notifications.
        </p>

        <!-- CTA Buttons -->
        <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="/events" class="w-full sm:w-auto px-7 py-3.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-bold text-sm shadow-xl shadow-brand-500/25 transition-all hover:-translate-y-0.5 flex items-center justify-center space-x-2">
            <i class="far fa-calendar-check"></i>
            <span>Explore Campus Events</span>
          </a>
          <a href="/rooms" class="w-full sm:w-auto px-7 py-3.5 rounded-xl bg-white hover:bg-slate-50 text-slate-800 font-bold text-sm border border-slate-300 shadow-sm transition-all hover:-translate-y-0.5 flex items-center justify-center space-x-2">
            <i class="far fa-building text-brand-600"></i>
            <span>Book a Venue / Room</span>
          </a>
        </div>

        <!-- Quick Stats Pill -->
        <div class="mt-12 grid grid-cols-2 sm:grid-cols-4 gap-4 max-w-2xl mx-auto text-left">
          <div class="bg-white/80 backdrop-blur p-4 rounded-2xl border border-slate-200/80 shadow-sm">
            <div class="text-2xl font-black text-brand-600">100%</div>
            <div class="text-xs font-semibold text-slate-500 mt-0.5">Conflict Free Slots</div>
          </div>
          <div class="bg-white/80 backdrop-blur p-4 rounded-2xl border border-slate-200/80 shadow-sm">
            <div class="text-2xl font-black text-indigo-600">Real-Time</div>
            <div class="text-xs font-semibold text-slate-500 mt-0.5">Socket.IO Sync</div>
          </div>
          <div class="bg-white/80 backdrop-blur p-4 rounded-2xl border border-slate-200/80 shadow-sm">
            <div class="text-2xl font-black text-emerald-600">QR Code</div>
            <div class="text-xs font-semibold text-slate-500 mt-0.5">Instant Event Passes</div>
          </div>
          <div class="bg-white/80 backdrop-blur p-4 rounded-2xl border border-slate-200/80 shadow-sm">
            <div class="text-2xl font-black text-purple-600">Automated</div>
            <div class="text-xs font-semibold text-slate-500 mt-0.5">Cron & Email Alerts</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Upcoming Events -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-10">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-brand-600">Happening on Campus</span>
          <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 mt-1">Featured College Events</h2>
        </div>
        <a href="/events" class="mt-3 sm:mt-0 text-sm font-semibold text-brand-600 hover:text-brand-700 flex items-center space-x-1">
          <span>View all upcoming events</span>
          <i class="fas fa-arrow-right text-xs"></i>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <% if (featuredEvents && featuredEvents.length > 0) { %>
          <% featuredEvents.forEach(event => { %>
            <div class="group bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col hover:-translate-y-1">
              <div class="relative h-48 w-full overflow-hidden bg-slate-100">
                <img src="<%= event.bannerImage %>" alt="<%= event.title %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                <div class="absolute top-3 left-3 bg-white/90 backdrop-blur-md px-2.5 py-1 rounded-lg text-xs font-bold text-slate-800 shadow-sm">
                  <%= event.category %>
                </div>
                <div class="absolute bottom-3 right-3 bg-slate-900/80 backdrop-blur text-white px-2.5 py-1 rounded-lg text-xs font-medium">
                  <i class="far fa-clock mr-1"></i><%= event.startTime %>
                </div>
              </div>
              <div class="p-6 flex-1 flex flex-col justify-between">
                <div>
                  <div class="text-xs font-semibold text-brand-600 mb-1">
                    <i class="far fa-calendar-alt mr-1"></i><%= new Date(event.date).toDateString() %>
                  </div>
                  <h3 class="text-lg font-bold text-slate-900 group-hover:text-brand-600 transition-colors line-clamp-1">
                    <%= event.title %>
                  </h3>
                  <p class="text-xs text-slate-500 mt-2 line-clamp-2 leading-relaxed">
                    <%= event.description %>
                  </p>
                </div>

                <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between">
                  <div class="text-xs text-slate-500 truncate max-w-[150px]">
                    <i class="fas fa-map-marker-alt text-slate-400 mr-1"></i>
                    <%= event.room ? event.room.name : event.customVenue || 'Campus' %>
                  </div>
                  <a href="/events/<%= event._id %>" class="px-3.5 py-1.5 rounded-lg bg-brand-50 hover:bg-brand-600 text-brand-700 hover:text-white text-xs font-bold transition-all">
                    Register Pass
                  </a>
                </div>
              </div>
            </div>
          <% }) %>
        <% } else { %>
          <div class="col-span-3 text-center py-12 bg-slate-50 rounded-2xl border border-dashed border-slate-300">
            <i class="far fa-calendar-times text-4xl text-slate-400 mb-3"></i>
            <p class="text-slate-500 text-sm">No events scheduled yet. Run the database seed to load demo events!</p>
          </div>
        <% } %>
      </div>
    </div>
  </section>

  <!-- Featured Campus Venues & Rooms -->
  <section class="py-16 bg-slate-50 border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-10">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-brand-600">Smart Campus Infrastructure</span>
          <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 mt-1">Book Lecture Halls & Labs</h2>
        </div>
        <a href="/rooms" class="mt-3 sm:mt-0 text-sm font-semibold text-brand-600 hover:text-brand-700 flex items-center space-x-1">
          <span>Explore all venues</span>
          <i class="fas fa-arrow-right text-xs"></i>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <% if (featuredRooms && featuredRooms.length > 0) { %>
          <% featuredRooms.forEach(room => { %>
            <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col">
              <div class="relative h-44 w-full bg-slate-100 overflow-hidden">
                <img src="<%= room.image %>" alt="<%= room.name %>" class="w-full h-full object-cover">
                <span class="absolute top-3 right-3 px-2.5 py-1 rounded-md text-xs font-bold <%= room.isAvailable ? 'bg-emerald-100 text-emerald-800' : 'bg-rose-100 text-rose-800' %>">
                  <%= room.isAvailable ? 'Available' : 'Under Maintenance' %>
                </span>
                <span class="absolute bottom-3 left-3 bg-slate-900/80 backdrop-blur text-white px-2.5 py-1 rounded-md text-xs font-medium">
                  <i class="fas fa-users mr-1"></i>Capacity: <%= room.capacity %>
                </span>
              </div>
              <div class="p-6 flex-1 flex flex-col justify-between">
                <div>
                  <div class="text-xs font-semibold text-brand-600 uppercase tracking-wider"><%= room.roomType %></div>
                  <h3 class="text-lg font-bold text-slate-900 mt-0.5"><%= room.name %></h3>
                  <p class="text-xs text-slate-500 mt-1">
                    <i class="far fa-building mr-1"></i><%= room.building %> &bull; <%= room.floor %>
                  </p>
                  
                  <!-- Amenities Pills -->
                  <div class="flex flex-wrap gap-1.5 mt-3">
                    <% room.amenities.slice(0, 3).forEach(amenity => { %>
                      <span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-slate-100 text-slate-600">
                        <%= amenity %>
                      </span>
                    <% }) %>
                  </div>
                </div>

                <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between">
                  <span class="text-xs font-medium text-slate-500">Conflict-Free Slots</span>
                  <a href="/rooms/<%= room._id %>" class="px-4 py-2 rounded-xl bg-brand-600 hover:bg-brand-700 text-white text-xs font-bold transition-all shadow-sm">
                    View & Book
                  </a>
                </div>
              </div>
            </div>
          <% }) %>
        <% } else { %>
          <div class="col-span-3 text-center py-12 bg-white rounded-2xl border border-dashed border-slate-300">
            <i class="far fa-building text-4xl text-slate-400 mb-3"></i>
            <p class="text-slate-500 text-sm">No rooms added yet. Run the database seed to load campus rooms!</p>
          </div>
        <% } %>
      </div>
    </div>
  </section>

  <!-- Real-World System Architecture Showcase -->
  <section class="py-16 bg-white border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="text-xs font-bold uppercase tracking-wider text-brand-600">Engineered for Reliability</span>
        <h2 class="text-3xl font-bold text-slate-900 mt-1">Enterprise-Grade Features</h2>
        <p class="text-sm text-slate-600 mt-2">Fully loaded with modern full-stack technologies ready for deployment on Railway & Vercel.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 hover:border-brand-300 transition-colors">
          <div class="w-12 h-12 rounded-xl bg-brand-100 text-brand-600 flex items-center justify-center text-xl mb-4">
            <i class="fas fa-bolt"></i>
          </div>
          <h3 class="text-base font-bold text-slate-900">Real-Time Socket.IO</h3>
          <p class="text-xs text-slate-600 mt-2 leading-relaxed">
            Live slot locking, instant booking status updates without page reload, and real-time attendee RSVP counters.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 hover:border-brand-300 transition-colors">
          <div class="w-12 h-12 rounded-xl bg-indigo-100 text-indigo-600 flex items-center justify-center text-xl mb-4">
            <i class="fas fa-database"></i>
          </div>
          <h3 class="text-base font-bold text-slate-900">Redis Caching</h3>
          <p class="text-xs text-slate-600 mt-2 leading-relaxed">
            Blazing-fast response times for room listings, upcoming events, and dashboard metrics with intelligent in-memory fallback.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 hover:border-brand-300 transition-colors">
          <div class="w-12 h-12 rounded-xl bg-purple-100 text-purple-600 flex items-center justify-center text-xl mb-4">
            <i class="far fa-envelope"></i>
          </div>
          <h3 class="text-base font-bold text-slate-900">Nodemailer & Node-Cron</h3>
          <p class="text-xs text-slate-600 mt-2 leading-relaxed">
            Automated 24-hour event reminders, auto-cancellation of past pending bookings, and styled HTML tickets with QR codes.
          </p>
        </div>
      </div>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
