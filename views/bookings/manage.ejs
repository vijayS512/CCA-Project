<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<%- include('../partials/alerts') %>

<main class="flex-1 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full">
  <div class="flex flex-col md:flex-row md:items-center justify-between pb-6 border-b border-slate-200">
    <div>
      <h1 class="text-3xl font-extrabold text-slate-900">Manage Room Bookings</h1>
      <p class="text-sm text-slate-500 mt-1">Review, approve, or reject campus venue reservation requests</p>
    </div>

    <!-- Quick Status Filter Pills -->
    <div class="mt-4 md:mt-0 flex flex-wrap gap-2">
      <a href="/bookings/manage" class="px-3 py-1.5 rounded-xl text-xs font-bold transition-all <%= currentFilter.status === 'all' ? 'bg-brand-600 text-white shadow-md shadow-brand-500/25' : 'bg-white border border-slate-200 text-slate-600 hover:bg-slate-50' %>">
        All Bookings
      </a>
      <a href="/bookings/manage?status=pending" class="px-3 py-1.5 rounded-xl text-xs font-bold transition-all <%= currentFilter.status === 'pending' ? 'bg-amber-500 text-white shadow-md' : 'bg-white border border-slate-200 text-slate-600 hover:bg-slate-50' %>">
        Pending Review
      </a>
      <a href="/bookings/manage?status=approved" class="px-3 py-1.5 rounded-xl text-xs font-bold transition-all <%= currentFilter.status === 'approved' ? 'bg-emerald-600 text-white shadow-md' : 'bg-white border border-slate-200 text-slate-600 hover:bg-slate-50' %>">
        Approved
      </a>
      <a href="/bookings/manage?status=rejected" class="px-3 py-1.5 rounded-xl text-xs font-bold transition-all <%= currentFilter.status === 'rejected' ? 'bg-rose-600 text-white shadow-md' : 'bg-white border border-slate-200 text-slate-600 hover:bg-slate-50' %>">
        Rejected
      </a>
    </div>
  </div>

  <div class="mt-8">
    <% if (bookings && bookings.length > 0) { %>
      <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-slate-50 border-b border-slate-200 text-[11px] font-bold text-slate-500 uppercase tracking-wider">
                <th class="py-3.5 px-4 sm:px-6">Applicant</th>
                <th class="py-3.5 px-4">Room & Schedule</th>
                <th class="py-3.5 px-4">Purpose & Attendees</th>
                <th class="py-3.5 px-4">Status</th>
                <th class="py-3.5 px-4 text-right">Review Action</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 text-xs text-slate-700">
              <% bookings.forEach(booking => { %>
                <tr class="hover:bg-slate-50/60 transition-colors">
                  <td class="py-4 px-4 sm:px-6">
                    <div class="font-bold text-slate-900"><%= booking.user ? booking.user.name : 'Unknown' %></div>
                    <div class="text-[11px] text-slate-400">
                      <%= booking.user ? booking.user.email : '' %> &bull; 
                      <span class="uppercase font-semibold text-brand-600"><%= booking.user ? booking.user.role : '' %></span>
                    </div>
                    <div class="text-[10px] text-slate-400">
                      Dept: <%= booking.user ? booking.user.department : 'General' %>
                    </div>
                  </td>
                  <td class="py-4 px-4">
                    <div class="font-bold text-brand-600"><%= booking.room ? booking.room.name : 'Deleted Room' %></div>
                    <div class="text-[11px] font-semibold text-slate-800"><%= booking.date %></div>
                    <div class="text-[10px] text-slate-500"><%= booking.startTime %> - <%= booking.endTime %></div>
                  </td>
                  <td class="py-4 px-4 max-w-xs">
                    <p class="font-medium text-slate-800 truncate" title="<%= booking.purpose %>"><%= booking.purpose %></p>
                    <span class="text-[10px] text-slate-400">Expected: <%= booking.expectedAttendees %> attendees</span>
                    <% if (booking.adminRemarks) { %>
                      <p class="text-[10px] text-slate-500 italic mt-1">Remarks: "<%= booking.adminRemarks %>"</p>
                    <% } %>
                  </td>
                  <td class="py-4 px-4">
                    <% if (booking.status === 'approved') { %>
                      <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 uppercase">
                        Approved
                      </span>
                    <% } else if (booking.status === 'pending') { %>
                      <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800 uppercase animate-pulse">
                        Pending
                      </span>
                    <% } else if (booking.status === 'rejected') { %>
                      <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-rose-100 text-rose-800 uppercase">
                        Rejected
                      </span>
                    <% } else { %>
                      <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-slate-100 text-slate-600 uppercase">
                        <%= booking.status %>
                      </span>
                    <% } %>
                  </td>
                  <td class="py-4 px-4 text-right">
                    <% if (booking.status === 'pending') { %>
                      <div class="flex items-center justify-end space-x-1.5">
                        <!-- Quick Approve Form -->
                        <form action="/bookings/<%= booking._id %>/status" method="POST" class="inline">
                          <input type="hidden" name="status" value="approved">
                          <input type="hidden" name="adminRemarks" value="Approved by administrator.">
                          <button type="submit" class="px-2.5 py-1 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs rounded-lg transition-colors shadow-sm">
                            <i class="fas fa-check mr-1"></i>Approve
                          </button>
                        </form>

                        <!-- Quick Reject Form -->
                        <button type="button" onclick="openRejectModal('<%= booking._id %>', '<%= booking.room ? booking.room.name : '' %>')" class="px-2.5 py-1 bg-rose-600 hover:bg-rose-700 text-white font-bold text-xs rounded-lg transition-colors shadow-sm">
                          <i class="fas fa-times mr-1"></i>Reject
                        </button>
                      </div>
                    <% } else { %>
                      <span class="text-[11px] text-slate-400">
                        Reviewed <%= booking.reviewedAt ? new Date(booking.reviewedAt).toLocaleDateString() : '' %>
                      </span>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% } else { %>
      <div class="py-16 text-center bg-white rounded-2xl border border-dashed border-slate-300">
        <i class="fas fa-clipboard-check text-4xl text-slate-300 mb-3"></i>
        <h3 class="text-base font-bold text-slate-800">No Bookings In This Category</h3>
        <p class="text-xs text-slate-500 mt-1">All room reservations have been processed or none match the filter.</p>
      </div>
    <% } %>
  </div>
</main>

<!-- Reject Modal Dialog -->
<div id="rejectModal" class="hidden fixed inset-0 z-50 overflow-y-auto bg-slate-900/50 backdrop-blur-sm flex items-center justify-center p-4">
  <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl border border-slate-200">
    <div class="flex items-center justify-between pb-3 border-b border-slate-100">
      <h3 class="text-base font-bold text-slate-900">Reject Booking Request</h3>
      <button onclick="closeRejectModal()" class="text-slate-400 hover:text-slate-600"><i class="fas fa-times"></i></button>
    </div>
    <form id="rejectForm" method="POST" class="mt-4 space-y-4">
      <input type="hidden" name="status" value="rejected">
      <div>
        <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Reason / Remarks for Applicant</label>
        <textarea name="adminRemarks" required rows="3" placeholder="e.g. Prior department commitment, maintenance scheduled..." class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-xl text-xs focus:bg-white focus:outline-none focus:ring-2 focus:ring-rose-500"></textarea>
      </div>
      <div class="pt-2 flex justify-end space-x-2">
        <button type="button" onclick="closeRejectModal()" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs rounded-xl">Cancel</button>
        <button type="submit" class="px-5 py-2 bg-rose-600 hover:bg-rose-700 text-white font-bold text-xs rounded-xl shadow-md">Confirm Rejection</button>
      </div>
    </form>
  </div>
</div>

<script>
  function openRejectModal(bookingId, roomName) {
    const modal = document.getElementById('rejectModal');
    const form = document.getElementById('rejectForm');
    form.action = `/bookings/${bookingId}/status`;
    modal.classList.remove('hidden');
  }

  function closeRejectModal() {
    document.getElementById('rejectModal').classList.add('hidden');
  }
</script>

<%- include('../partials/footer') %>
