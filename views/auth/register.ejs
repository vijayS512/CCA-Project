<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<%- include('../partials/alerts') %>

<main class="flex-1 flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-lg w-full bg-white rounded-2xl shadow-xl border border-slate-200/80 p-8">
    <div class="text-center">
      <div class="w-12 h-12 rounded-xl bg-brand-50 text-brand-600 flex items-center justify-center text-xl mx-auto mb-3">
        <i class="fas fa-user-plus"></i>
      </div>
      <h2 class="text-2xl font-black text-slate-900">Create CampusConnect Account</h2>
      <p class="text-xs text-slate-500 mt-1">Join your campus network to book venues and attend events</p>
    </div>

    <form class="mt-6 space-y-4" action="/auth/register" method="POST">
      <div>
        <label for="name" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Full Name</label>
        <input id="name" name="name" type="text" required placeholder="Alex Turner" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500">
      </div>

      <div>
        <label for="email" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">College Email Address</label>
        <input id="email" name="email" type="email" required placeholder="alex@campus.edu" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500">
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="role" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Campus Role</label>
          <select id="role" name="role" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500">
            <option value="student">Student</option>
            <option value="faculty">Faculty / Organizer</option>
          </select>
        </div>
        <div>
          <label for="department" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Department</label>
          <input id="department" name="department" type="text" placeholder="Computer Science" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500">
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="studentOrEmployeeId" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Student / Employee ID</label>
          <input id="studentOrEmployeeId" name="studentOrEmployeeId" type="text" placeholder="CS-2024-042" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500">
        </div>
        <div>
          <label for="phone" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Phone Number</label>
          <input id="phone" name="phone" type="text" placeholder="+1 (555) 019-2834" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500">
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="password" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Password</label>
          <input id="password" name="password" type="password" required minlength="6" placeholder="••••••••" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500">
        </div>
        <div>
          <label for="confirmPassword" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Confirm Password</label>
          <input id="confirmPassword" name="confirmPassword" type="password" required minlength="6" placeholder="••••••••" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500">
        </div>
      </div>

      <div class="pt-2">
        <button type="submit" class="w-full py-3 px-4 bg-brand-600 hover:bg-brand-700 text-white font-bold rounded-xl shadow-lg shadow-brand-500/25 transition-all text-sm">
          Complete Registration
        </button>
      </div>
    </form>

    <div class="mt-6 text-center text-xs text-slate-500">
      Already have an account? 
      <a href="/auth/login" class="font-bold text-brand-600 hover:text-brand-700">Sign In</a>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
