<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<%- include('../partials/alerts') %>

<main class="flex-1 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full">
  <div class="mb-4 flex items-center space-x-2 text-xs text-slate-500">
    <a href="/events" class="hover:text-brand-600">Events</a>
    <span>/</span>
    <span class="text-slate-800 font-bold">Host New Event</span>
  </div>

  <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-8">
    <div class="border-b border-slate-100 pb-4 mb-6">
      <h1 class="text-2xl font-black text-slate-900">Host Campus Event / Workshop</h1>
      <p class="text-xs text-slate-500 mt-1">Publish college events, manage attendee RSVP capacity, and optionally auto-reserve campus venues.</p>
    </div>

    <form action="/events/new" method="POST" class="space-y-6">
      <div>
        <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Event Title</label>
        <input type="text" name="title" required placeholder="e.g. Annual Hackathon 2026, AI & Cloud Computing Seminar" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500">
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Event Category</label>
          <select name="category" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500">
            <% categories.forEach(cat => { %>
              <option value="<%= cat %>"><%= cat %></option>
            <% }) %>
          </select>
        </div>
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Organizing Club / Department</label>
          <input type="text" name="organizingClub" value="<%= currentUser.department || 'Student Technical Chapter' %>" required class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500">
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Event Date</label>
          <input type="date" name="date" required class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500">
        </div>
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Start Time</label>
          <input type="time" name="startTime" value="10:00" required class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500">
        </div>
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">End Time</label>
          <input type="time" name="endTime" value="13:00" required class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500">
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Venue Type</label>
          <select id="venueType" name="venueType" onchange="toggleVenueFields(this.value)" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500">
            <option value="Room">Campus Room / Hall (Auto-Book)</option>
            <option value="Outdoor">Outdoor Campus Grounds</option>
            <option value="Virtual">Virtual / Online Webinar</option>
          </select>
        </div>

        <div id="roomSelectBox">
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Select Campus Venue</label>
          <select name="roomId" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500">
            <% rooms.forEach(room => { %>
              <option value="<%= room._id %>"><%= room.name %> (<%= room.building %> - Cap: <%= room.capacity %>)</option>
            <% }) %>
          </select>
        </div>

        <div id="customVenueBox" class="hidden">
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Custom Location Name / Link</label>
          <input type="text" name="customVenue" placeholder="e.g. Football Ground, Zoom Meeting Link" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500">
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Seat Capacity / Max Attendees</label>
          <input type="number" name="capacity" min="5" value="100" required class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500">
        </div>
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Banner Image URL</label>
          <input type="url" name="bannerImage" value="https://images.unsplash.com/photo-1540575467063-178a50c2df87?auto=format&fit=crop&w=1000&q=80" placeholder="https://images.unsplash.com/..." class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500">
        </div>
      </div>

      <div>
        <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Detailed Description & Agenda</label>
        <textarea name="description" rows="5" required placeholder="Outline event schedule, keynote speakers, eligibility, prerequisites, and prizes..." class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500"></textarea>
      </div>

      <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
        <a href="/events" class="px-5 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs rounded-xl">Cancel</a>
        <button type="submit" class="px-7 py-2.5 bg-brand-600 hover:bg-brand-700 text-white font-bold text-xs rounded-xl shadow-md shadow-brand-500/25">
          Publish Event
        </button>
      </div>
    </form>
  </div>
</main>

<script>
  function toggleVenueFields(type) {
    const roomBox = document.getElementById('roomSelectBox');
    const customBox = document.getElementById('customVenueBox');
    if (type === 'Room') {
      roomBox.classList.remove('hidden');
      customBox.classList.add('hidden');
    } else {
      roomBox.classList.add('hidden');
      customBox.classList.remove('hidden');
    }
  }
</script>

<%- include('../partials/footer') %>
