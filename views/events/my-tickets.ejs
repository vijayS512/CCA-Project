<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<%- include('../partials/alerts') %>

<main class="flex-1 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-6 border-b border-slate-200">
    <div>
      <h1 class="text-3xl font-extrabold text-slate-900">My Event Passes & Tickets</h1>
      <p class="text-sm text-slate-500 mt-1">Present these QR passes at venue entrance for instant check-in verification</p>
    </div>
    <div class="mt-4 sm:mt-0">
      <a href="/events" class="inline-flex items-center px-4 py-2 bg-brand-600 hover:bg-brand-700 text-white font-bold text-xs rounded-xl shadow-md shadow-brand-500/25 transition-all">
        <i class="far fa-calendar-alt mr-2"></i>Browse More Events
      </a>
    </div>
  </div>

  <div class="mt-8">
    <% if (registrations && registrations.length > 0) { %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <% registrations.forEach(reg => { %>
          <% const evt = reg.event; %>
          <% if (evt) { %>
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden flex flex-col sm:flex-row hover:shadow-lg transition-all border-dashed border-2">
              
              <!-- Left ticket info -->
              <div class="p-6 flex-1 flex flex-col justify-between">
                <div>
                  <div class="flex items-center space-x-2">
                    <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-brand-50 text-brand-700 uppercase">
                      <%= evt.category %>
                    </span>
                    <% if (reg.checkedIn) { %>
                      <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 uppercase">
                        Checked-In
                      </span>
                    <% } %>
                  </div>

                  <h3 class="text-lg font-bold text-slate-900 mt-2 line-clamp-1"><%= evt.title %></h3>
                  
                  <div class="mt-3 space-y-1 text-xs text-slate-500">
                    <div>
                      <i class="far fa-calendar text-brand-600 mr-1.5"></i>
                      <%= new Date(evt.date).toDateString() %> at <%= evt.startTime %>
                    </div>
                    <div>
                      <i class="fas fa-map-marker-alt text-brand-600 mr-1.5"></i>
                      <%= evt.room ? evt.room.name + ' (' + evt.room.building + ')' : evt.customVenue || 'Campus' %>
                    </div>
                  </div>
                </div>

                <div class="mt-4 pt-3 border-t border-slate-100">
                  <div class="text-[10px] uppercase font-bold text-slate-400">Unique Pass Code</div>
                  <div class="text-sm font-mono font-black text-brand-700"><%= reg.ticketCode %></div>
                </div>
              </div>

              <!-- Right QR Stub -->
              <div class="bg-slate-50 sm:w-48 p-6 flex flex-col items-center justify-center border-t sm:border-t-0 sm:border-l border-dashed border-slate-200 text-center">
                <% if (reg.qrCodeDataUrl) { %>
                  <img src="<%= reg.qrCodeDataUrl %>" alt="QR Code" class="w-28 h-28 object-contain rounded-lg border border-slate-200 bg-white p-1">
                <% } else { %>
                  <div class="w-28 h-28 bg-slate-200 rounded flex items-center justify-center text-xs text-slate-400">QR Code</div>
                <% } %>
                <button type="button" onclick="printTicket('<%= reg.ticketCode %>')" class="mt-3 text-[11px] font-bold text-brand-600 hover:text-brand-800 flex items-center space-x-1">
                  <i class="fas fa-print"></i>
                  <span>Print Ticket</span>
                </button>
              </div>

            </div>
          <% } %>
        <% }) %>
      </div>
    <% } else { %>
      <div class="py-16 text-center bg-white rounded-2xl border border-dashed border-slate-300">
        <i class="fas fa-ticket-alt text-4xl text-slate-300 mb-3"></i>
        <h3 class="text-base font-bold text-slate-800">No Event Passes Found</h3>
        <p class="text-xs text-slate-500 mt-1 max-w-sm mx-auto">You haven't RSVP'd for any college events or workshops yet.</p>
        <a href="/events" class="mt-4 inline-block px-5 py-2.5 bg-brand-600 hover:bg-brand-700 text-white font-bold text-xs rounded-xl shadow-md shadow-brand-500/25">
          Find Campus Events
        </a>
      </div>
    <% } %>
  </div>
</main>

<script>
  function printTicket(code) {
    window.print();
  }
</script>

<%- include('../partials/footer') %>
