<% if (typeof success_msg !== 'undefined' && success_msg.length > 0) { %>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-4">
    <div class="p-4 bg-emerald-50 border border-emerald-200 rounded-xl flex items-center justify-between text-emerald-800 shadow-sm animate-fade-in">
      <div class="flex items-center space-x-3">
        <i class="fas fa-check-circle text-emerald-600 text-lg"></i>
        <p class="text-sm font-medium"><%= success_msg %></p>
      </div>
      <button onclick="this.parentElement.remove()" class="text-emerald-500 hover:text-emerald-700">
        <i class="fas fa-times"></i>
      </button>
    </div>
  </div>
<% } %>

<% if (typeof error_msg !== 'undefined' && error_msg.length > 0) { %>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-4">
    <div class="p-4 bg-rose-50 border border-rose-200 rounded-xl flex items-center justify-between text-rose-800 shadow-sm animate-fade-in">
      <div class="flex items-center space-x-3">
        <i class="fas fa-exclamation-circle text-rose-600 text-lg"></i>
        <p class="text-sm font-medium"><%= error_msg %></p>
      </div>
      <button onclick="this.parentElement.remove()" class="text-rose-500 hover:text-rose-700">
        <i class="fas fa-times"></i>
      </button>
    </div>
  </div>
<% } %>
