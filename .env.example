# CampusConnect Configuration Environment Variables

# Server
PORT=5000
NODE_ENV=development
BASE_URL=http://localhost:5000

# MongoDB Database Connection
# Replace with your MongoDB Atlas URI or local connection string:
MONGODB_URI=mongodb://127.0.0.1:27017/campusconnect

# JWT Secret & Session Secret
JWT_SECRET=campusconnect_super_secret_jwt_key_2026_secure
SESSION_SECRET=campusconnect_super_session_secret_key_2026

# Redis Cache (Optional: leave empty or default; if Redis is unavailable, automatic in-memory fallback is used)
REDIS_URL=redis://127.0.0.1:6379

# Nodemailer Email Configuration
# You can use Ethereal (test account automatically used if empty), Gmail, or any SMTP service
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="CampusConnect System <noreply@campusconnect.edu>"

# Node Cron Configuration
CRON_ENABLED=true
